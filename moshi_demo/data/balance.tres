[sub_resource type="Resource" id="Resource_qm5k3"]
script = ExtResource("3_njojm")
id = "seg5_plateau"
until_time = 999999.0
interval = 0.2
cap = 64
mix = {
"charger_fast": 0.16,
"elite_charger": 0.07,
"elite_melee": 0.08,
"elite_ranged": 0.06,
"elite_splitter": 0.05,
"melee_mite": 0.26,
"ranged_crystal": 0.18,
"splitter_bomber": 0.14
}
note = "永久平台期。本局没有时限，27 秒之后一直用这一段，直到玩家体力（时滞次数）耗尽。
这是全局最高强度：0.18 秒一只、场上最多 64 只，四种精英到齐、合计占两成六。
想让后期更凶就调这里的 interval / cap，想加新段就在本目录再丢一个 .tres 并把 until_time 排在它前面。"

